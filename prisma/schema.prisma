generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  DONOR
  MEDICAL_STAFF
  LAB_TECHNICIAN
  HEALTH_INSTITUTE_ADMIN
  SYSTEM_ADMIN
}

enum Gender {
  MALE
  FEMALE
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum InstituteStatus {
  ACTIVE
  PENDING
  INACTIVE
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String   @unique
  passwordHash String
  phoneNumber  String?
  role         UserRole @default(DONOR)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  donorProfile DonorProfile?
  appointments Appointment[]

  @@index([email])
  @@map("users")
}

model DonorProfile {
  id                String      @id @default(cuid())
  userId            String      @unique
  dateOfBirth       DateTime?
  gender            Gender?
  bloodGroup        BloodGroup?
  address           String?
  city              String?
  lastDonationDate  DateTime?
  eligibilityStatus Boolean     @default(false)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("donor_profiles")
}

model HealthInstitute {
  id          String          @id @default(cuid())
  name        String
  email       String?
  phoneNumber String?
  address     String?
  city        String
  region      String?
  status      InstituteStatus @default(ACTIVE)
  isActive    Boolean         @default(true)

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([city])
  @@index([status])
  @@map("health_institutes")
}

model Appointment {
  id                String            @id @default(cuid())
  donorId           String
  healthInstituteId String
  appointmentDate   DateTime
  appointmentTime   String
  notes             String?
  status            AppointmentStatus @default(SCHEDULED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  donor           User            @relation(fields: [donorId], references: [id], onDelete: Cascade)
  healthInstitute HealthInstitute @relation(fields: [healthInstituteId], references: [id], onDelete: Cascade)

  @@index([donorId])
  @@index([healthInstituteId])
  @@index([appointmentDate])
  @@index([status])
  @@map("appointments")
}
